      "item": [
        {
          "id": "28ca2357-29c0-4818-ac5f-c7dbca620f5f",
          "name": "Search for properties",
          "request": {
            "name": "Search for properties",
            "description": {
              "content": "Returns property IDs and coordinates for properties matching the supplied attribute filters (settings) and map filters (circles, polygons, bounding box). Resubmit with the returned search_token to page through additional results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search",
                "summaries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search_token",
                  "value": "<string>",
                  "description": "Token returned by a prior search, used to retrieve the next page of results."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": {\n    \"asset_category\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"land_use_code_description\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"building_area\": {\n      \"min\": \"<number>\",\n      \"max\": \"<number>\"\n    },\n    \"sales_price\": {\n      \"min\": \"<number>\",\n      \"max\": \"<number>\"\n    },\n    \"master_update_time\": {\n      \"min\": \"<date>\",\n      \"max\": \"<date>\",\n      \"relative_min\": \"<integer>\",\n      \"relative_max\": \"<integer>\"\n    },\n    \"sale_update_time\": {\n      \"min\": \"<date>\",\n      \"max\": \"<date>\",\n      \"relative_min\": \"<integer>\",\n      \"relative_max\": \"<integer>\"\n    },\n    \"fips\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"map_filters\": {\n    \"circles\": [\n      {\n        \"lat\": \"<double>\",\n        \"lon\": \"<double>\",\n        \"radius_m\": \"<number>\"\n      },\n      {\n        \"lat\": \"<double>\",\n        \"lon\": \"<double>\",\n        \"radius_m\": \"<number>\"\n      }\n    ],\n    \"polygons\": [\n      {\n        \"coordinates\": [\n          {\n            \"lat\": \"<double>\",\n            \"lon\": \"<double>\"\n          },\n          {\n            \"lat\": \"<double>\",\n            \"lon\": \"<double>\"\n          }\n        ]\n      },\n      {\n        \"coordinates\": [\n          {\n            \"lat\": \"<double>\",\n            \"lon\": \"<double>\"\n          },\n          {\n            \"lat\": \"<double>\",\n            \"lon\": \"<double>\"\n          }\n        ]\n      }\n    ],\n    \"bounding_box\": {\n      \"top_left\": {\n        \"lat\": \"<double>\",\n        \"lon\": \"<double>\"\n      },\n      \"bottom_right\": {\n        \"lat\": \"<double>\",\n        \"lon\": \"<double>\"\n      }\n    }\n  },\n  \"sort\": [\n    {\n      \"name\": \"<string>\",\n      \"order\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"order\": \"<string>\"\n    }\n  ],\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
